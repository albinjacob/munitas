PG_USER=munitas
PG_PASSWORD=munitas
# The one folder that holds the platform's data: stored files, the synthetic
# corpus, downloaded models and scratch work. An absolute path with room for
# several gigabytes of model downloads. Nothing starts without it.
MUNITAS_DATA=D:/munitas-data
S3_ADMIN_KEY=munitas-admin
S3_ADMIN_SECRET=munitas-admin-secret
MUNITAS_MASTER_KEY=dev-master-key-not-for-production

# Only needed for `docker compose --profile quickstart up` (worker-lite,
# the GPU-free worker -- see docker-compose.yml's own service comment and
# worker/lite_worker.py's docstring). Not a container path: this machine's
# own absolute path to a scratch directory, created if it doesn't exist.
# Get it wrong or leave it unset and worker-lite refuses to start rather
# than silently writing files to a location that will confuse whatever
# looks for them later.
#
# Linux/macOS example: MUNITAS_HOST_WORK_DIR=/home/you/munitas/quickstart-work
# Windows with Docker Desktop example: MUNITAS_HOST_WORK_DIR=D:/munitas-data/quickstart-work
MUNITAS_HOST_WORK_DIR=

# Cloudflare R2, a second, optional object-storage backend. Leave blank on
# an install that only ever uses SeaweedFS; a dataset cannot be sealed
# against 'r2' without these, refused with a clear reason rather than a
# confusing failure. Real values go in your own .env, never here.
#
# The four token values below must come from one and the same R2 API
# token, created in R2 > API > Manage API tokens with "Admin Read &
# Write", which covers creating buckets and vending scoped credentials
# for them. Cloudflare shows you the token value once, at creation;
# R2_ACCESS_KEY_ID is that token's id and R2_SECRET_ACCESS_KEY is a
# SHA-256 hash of its value. Mixing values from two different tokens
# produces a credential that signs S3 requests as one identity and REST
# calls as another, which fails in a way that reads like a permissions
# problem. Verification checks the pair actually matches, so a mismatched
# paste is caught by name rather than guessed at.
#
# R2_BUCKET is optional and blank is the right value on a fresh install.
# Every tenant gets a bucket of its own, created on its first write, so
# there is no bucket to make by hand. This setting names the shared bucket
# that tenants predating per-tenant storage still read from, and it is
# only consulted for such a tenant.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_BUCKET=
