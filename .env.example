# Copy this file to .env and change what you need. Every line that starts with # is optional: the value shown is the default, so removing the #
# (and changing the value) is all it takes. A blank value means "not set". A setting written here takes effect for the API when its container is
# recreated, and for the host worker when it is restarted: run .\start-dev.ps1 (after .\stop-dev.ps1 for the worker).
#
# Every setting starts with MUNITAS_, in upper case with underscores. This file is generated from docs/tools/settings_reference.json by
# docs/tools/generate_settings_reference.py, so edit that file and regenerate, not this one. The same descriptions are published as the
# Configuration reference, docs/public/reference/configuration.html. The MUNITAS_PORT_* lines that start-dev.ps1 adds to your .env come from
# config.json: change a port there, never here.

# ------------------------------------------------------------------------------------------------------------------
# Folders and files on this machine
#
# Where the platform keeps its data, its scratch work and its logs. Most of these hang off one folder, MUNITAS_DATA,
# so that moving the data folder moves everything with it.
# ------------------------------------------------------------------------------------------------------------------

# The one folder that holds the platform's data on this machine: stored files, the synthetic sample files,
# downloaded models, scratch work and logs. Use an absolute path with room for several gigabytes of model downloads.
# Nothing starts without it. Docker Compose and the start script read it from .env, and the start script passes it
# on to the workers.
# Default: None. It is required.
MUNITAS_DATA=D:/munitas-data

# The scratch folder a worker uses while it runs a pipeline. By default it is the folder work inside MUNITAS_DATA.
# It must be an absolute path that is valid on the operating system the worker runs on, and the worker creates it
# when it is missing.
# Default: MUNITAS_DATA/work
# MUNITAS_WORK=

# The folder of synthetic sample files that practice runs and verification runs read. By default it is the folder
# synthetic inside MUNITAS_DATA. It is only read, never changed, so it must already exist.
# Default: MUNITAS_DATA/synthetic
# MUNITAS_CORPUS=

# The folder each worker writes its log file into. By default it is the folder logs inside MUNITAS_DATA. A log rolls
# over at 10 MB and five old files are kept, so logs cannot fill the disk. It must be an absolute path.
# Default: MUNITAS_DATA/logs
# MUNITAS_LOG_DIR=

# The file that alerts are written to: one line of JSON per alert, in one file for every category of alert, each
# line carrying its category. Inside the API container the path is under /logs, which is the logs folder of
# MUNITAS_DATA, so by default the file is MUNITAS_DATA/logs/alerts.jsonl on this machine. It rolls over at 10 MB and
# five old files are kept. An empty value switches the file off, and alerts are then recorded only in the log output
# and by the part of the platform that raised them.
# Default: /logs/alerts.jsonl
# MUNITAS_ALERTS_FILE=/logs/alerts.jsonl

# The file that holds the master key of the key service, which keeps each person's key. It is read from a mounted
# file and never from the environment or the database. The API starts without it, and only the routes that lock a
# person's data need it. The start script creates the file under infra/secrets.
# Default: /run/secrets/key_service_master
# MUNITAS_KEY_SERVICE_MASTER_FILE=/run/secrets/key_service_master

# A self-signed certificate that the worker trusts in addition to the operating system's own list, for use when
# MUNITAS_API points at a local HTTPS listener. Only the worker trusts it. Nothing is installed in the operating
# system's trust store. It is ignored when the file does not exist.
# Default: infra/tls/out/localhost.pem
# MUNITAS_API_CA_CERT=infra/tls/out/localhost.pem

# Only needed for the optional quickstart worker that runs inside Docker Compose (docker compose --profile
# quickstart up). The absolute path, on this machine, of the folder that worker uses for scratch work. It is not a
# path inside a container. The folder is created when it is missing. When it is wrong or unset, the quickstart
# worker refuses to start instead of writing files somewhere that would confuse whatever looks for them later.
# Default: Not set.
# MUNITAS_HOST_WORK_DIR=/home/you/munitas/quickstart-work

# ------------------------------------------------------------------------------------------------------------------
# Database
#
# The platform's own database.
# ------------------------------------------------------------------------------------------------------------------

# The connection string for the platform's database, with the user and password in it. The API requires it, and
# Docker Compose builds it from MUNITAS_PG_USER and MUNITAS_PG_PASSWORD. The verification checks, when run from this
# machine, need it set to the database's published port. The worker uses the local database on its published port
# when it is not set.
# Default: built from MUNITAS_PG_USER and MUNITAS_PG_PASSWORD.
# MUNITAS_PG_DSN=

# The database user. The database container creates it and the API connects as it.
# Default: munitas
MUNITAS_PG_USER=munitas

# The password of the database user. A development value is used when it is not set.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
MUNITAS_PG_PASSWORD=munitas

# ------------------------------------------------------------------------------------------------------------------
# Keys and secrets
#
# Values that must be kept private. Each has a development value so that a laptop starts without any setup. A
# development value is published in this repository, so it must be replaced in any shared or production deployment.
# MUNITAS_ENV can enforce that.
# ------------------------------------------------------------------------------------------------------------------

# The master key that wraps the platform's data keys. The API will not start without it. Docker Compose supplies a
# development value when none is set.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
MUNITAS_MASTER_KEY=dev-master-key-not-for-production

# The key that signs the manifest of a legal export, so that whoever receives the package can verify it. The public
# half is served at /legal-exports/signing-key. Keep it like the master key.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_SIGNING_KEY=

# A secret shared by the API and the host worker, checked on the one endpoint that serves an agent version's code to
# the worker. When it is unset on the API, that endpoint refuses every request, and the API still starts. Set the
# same value on both sides.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_WORKER_TOKEN=

# A secret shared by the API and the policy engine. The policy engine answers only a caller that presents it, and
# then only for decisions, so no other container or process on the machine can read its policies or replace one. The
# development value is published in this repository, so a production start refuses it.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_OPA_TOKEN=

# The access key of the storage administrator identity, which creates buckets.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
MUNITAS_S3_ADMIN_KEY=munitas-admin

# The secret of the storage administrator identity. Every storage key the platform hands out, one per organisation,
# per job and per catalog session, is derived from this secret, so anybody who has read the published development
# value could compute them all. Replace it in any shared deployment.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
MUNITAS_S3_ADMIN_SECRET=munitas-admin-secret

# The access key of the standing storage identity of the pipeline action role. Each role that holds a storage key
# has one pair, and the platform compiles them into the storage permissions document. Leave it empty to use the
# development value.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_PIPELINE_KEY=

# The secret of the standing storage identity of the pipeline action role. Leave it empty to use the development
# value; set your own in any shared deployment.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_PIPELINE_SECRET=

# The access key of the standing storage identity of the training job role. Each role that holds a storage key has
# one pair, and the platform compiles them into the storage permissions document. Leave it empty to use the
# development value.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_TRAINING_JOB_KEY=

# The secret of the standing storage identity of the training job role. Leave it empty to use the development value;
# set your own in any shared deployment.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_TRAINING_JOB_SECRET=

# The access key of the standing storage identity of the annotation tool role. Each role that holds a storage key
# has one pair, and the platform compiles them into the storage permissions document. Leave it empty to use the
# development value.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_ANNOTATION_TOOL_KEY=

# The secret of the standing storage identity of the annotation tool role. Leave it empty to use the development
# value; set your own in any shared deployment.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_ANNOTATION_TOOL_SECRET=

# The access key of the standing storage identity of the researcher notebook role. Each role that holds a storage
# key has one pair, and the platform compiles them into the storage permissions document. Leave it empty to use the
# development value.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_NOTEBOOK_EXPLORE_KEY=

# The secret of the standing storage identity of the researcher notebook role. Leave it empty to use the development
# value; set your own in any shared deployment.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_NOTEBOOK_EXPLORE_SECRET=

# The access key of the standing storage identity of the agent runtime role. Each role that holds a storage key has
# one pair, and the platform compiles them into the storage permissions document. Leave it empty to use the
# development value.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_AGENT_RUNTIME_KEY=

# The secret of the standing storage identity of the agent runtime role. Leave it empty to use the development
# value; set your own in any shared deployment.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_S3_AGENT_RUNTIME_SECRET=

# The secret the notebook sign-in service uses to protect what it stores. At least 16 characters. Docker Compose
# supplies a development value when none is set; a real deployment must set its own and keep it out of the
# repository. Never put the value in documentation.
# Default: A development value is used when it is not set. Set your own for any shared or production deployment.
# MUNITAS_HYDRA_SYSTEM_SECRET=

# ------------------------------------------------------------------------------------------------------------------
# Production safety
#
# A switch that makes the platform refuse to run on published secrets.
# ------------------------------------------------------------------------------------------------------------------

# Set it to production and the platform refuses to start while the storage administrator secret or the worker token
# still holds the value published in this repository. The refusal names the settings at fault and never prints their
# values. Any other value, or none, is a development start.
# Default: Not set.
# MUNITAS_ENV=production

# ------------------------------------------------------------------------------------------------------------------
# Object storage
#
# Where files are stored, and how the platform reaches the storage engine.
# ------------------------------------------------------------------------------------------------------------------

# The address the platform uses to reach object storage. Inside the Compose network it is http://seaweedfs:8333. The
# host worker and the scripts use the published port on localhost instead.
# Default: http://seaweedfs:8333 for the API, http://localhost:<storage port> for the worker.
# MUNITAS_S3_ENDPOINT=

# The storage address that a person's own tool (DuckDB or PyIceberg, for example) can reach from their machine. The
# table catalog puts it in the configuration it hands out. The API itself reaches storage at MUNITAS_S3_ENDPOINT,
# which only exists inside the Compose network.
# Default: http://localhost:<storage port>
# MUNITAS_PUBLIC_S3_ENDPOINT=

# The address of the storage engine's filer, where the permissions document is kept. It is reached inside the
# Compose network and is never published.
# Default: http://seaweedfs:8888
# MUNITAS_FILER_URL=http://seaweedfs:8888

# The address of the storage engine's master, which the platform asks for volume status and tells to grow volumes.
# Default: http://seaweedfs:9333
# MUNITAS_MASTER_URL=http://seaweedfs:9333

# How many storage volumes an organisation's bucket is given when it first writes. A volume is a large file that
# many stored objects are appended into, up to 1 GB, and volumes are never shared between organisations, so this is
# paid per organisation and not per byte. One is right for many small organisations. An organisation that fills its
# volume is given another automatically, so a value that is too low costs a brief pause, while a value that is too
# high can run the machine out of volumes. An organisation expected to be large says so when it is onboarded, and
# that wins over this setting.
# Unit: volumes.
# Default: 1 volume.
# MUNITAS_STORAGE_VOLUMES_PER_TENANT=1

# ------------------------------------------------------------------------------------------------------------------
# Cloudflare R2 (optional)
#
# R2 is an optional second storage backend. Leave every R2 setting empty on an installation that only uses the
# built-in storage: a dataset then cannot be sealed against R2, and the refusal says why. The four credential values
# must come from one and the same R2 API token, created under R2, API, Manage API tokens, with Admin Read and Write
# permission. Cloudflare shows the token value once, when it is created. The access key id is the token's id, and
# the secret access key is a SHA-256 hash of its value. Mixing values from two tokens produces a credential that
# signs storage requests as one identity and Cloudflare requests as another, and that fails in a way that reads like
# a permissions problem.
# ------------------------------------------------------------------------------------------------------------------

# The Cloudflare account id.
# Default: Not set.
# MUNITAS_R2_ACCOUNT_ID=

# The id of the R2 API token. It is the access key of the S3 side.
# Default: Not set.
# MUNITAS_R2_ACCESS_KEY_ID=

# The SHA-256 hash of the R2 API token's value, which is the secret of the S3 side. Verification checks that this
# pair really belongs to the token below, so a mismatched paste is caught by name.
# Default: Not set.
# MUNITAS_R2_SECRET_ACCESS_KEY=

# The R2 API token itself. Cloudflare's own REST API (creating a bucket, minting a scoped token, issuing a temporary
# credential) authenticates with this value as a bearer, while the S3 protocol uses the id and the hash above. The
# hash is one way, so this value has to be carried separately.
# Default: Not set.
# MUNITAS_R2_API_TOKEN=

# ------------------------------------------------------------------------------------------------------------------
# Services the platform talks to
#
# The addresses of the other services. Inside the Compose network they are service names and need no change. The
# host worker reaches the same services on the ports published on this machine.
# ------------------------------------------------------------------------------------------------------------------

# The address of the policy engine, which decides every request.
# Default: http://opa:8181
# MUNITAS_OPA_URL=http://opa:8181

# How the policy engine gets its policy. folder: it reads the policy folder and reloads when a file changes, which
# is quickest while you are changing the rules; a change that does not compile is logged and the last good policy
# keeps answering. bundle: it fetches a signed package that publish-policy.ps1 has tested, built and put in storage,
# and a package that is unsigned, signed by another key, altered or otherwise does not load is refused and leaves
# the last good one in place. A production start (MUNITAS_ENV=production) requires bundle. Only the start scripts
# read it; anything other than folder or bundle is refused by name.
# Default: folder
# MUNITAS_OPA_POLICY_SOURCE=bundle

# The address of the score store that a de-identification run writes its score card to. The API only asks whether it
# is up, before such a run starts.
# Default: http://mlflow:5000 for the API, http://localhost:<score store port> for the worker.
# MUNITAS_MLFLOW_URL=

# The public address of the sign-in service, used to verify a person's session. The API starts before the sign-in
# service is ready, and without it, so this is not required at start-up.
# Default: http://kratos:4433
# MUNITAS_KRATOS_PUBLIC_URL=http://kratos:4433

# The admin address of the sign-in service. Only a purge uses it, to remove the sign-in accounts of the organisation
# it deletes, and nothing else.
# Default: http://kratos:4434
# MUNITAS_KRATOS_ADMIN_URL=http://kratos:4434

# The address of the workflow engine, as host and port.
# Default: temporal:7233 inside the Compose network, localhost:<workflow engine port> for the worker.
# MUNITAS_TEMPORAL_ADDRESS=

# The address of the annotation tool, as the worker reaches it.
# Default: http://localhost:<annotation tool port>
# MUNITAS_LABEL_STUDIO_URL=

# The address of the control plane (the API), as the worker and the table worker reach it. The worker refuses to
# start when this points off the machine over plain HTTP, because the same traffic carries a person's HuggingFace
# token and the worker token. Use an https address for a real deployment.
# Default: http://localhost:<API port> for the worker, http://munitas-api:8000 for the table worker.
# MUNITAS_API=

# Where a sandboxed agent run reaches the control plane from inside its own network. It is a service name, resolved
# from inside the sandbox container.
# Default: http://munitas-api:8000
# MUNITAS_SANDBOX_API=http://munitas-api:8000

# The origins that may call the API from a browser, as a comma separated list. They are listed and never replaced by
# a wildcard, because a wildcard would let any page the operator happens to visit drive the control plane. Compose
# builds the value from the console's ports. The API must also stay bound to localhost.
# Default: http://localhost:3000,http://localhost:5173
# MUNITAS_CONSOLE_ORIGINS=

# The admin address of the notebook sign-in service, which issues, renews and ends the short-lived pass a notebook
# signs in with. It stays private to the platform's own services and is never published on this machine.
# Default: http://hydra:4445
# MUNITAS_HYDRA_ADMIN_URL=http://hydra:4445

# The address the API itself uses to reach the notebook sign-in service to start a sign-in, check its code and renew
# a pass. It is not the address a person's browser is sent to; that is set by the sign-in service itself, from the
# port in config.json.
# Default: http://hydra:4444
# MUNITAS_HYDRA_PUBLIC_URL=http://hydra:4444

# The name every notebook signs in under at the notebook sign-in service. The platform creates it there the first
# time a notebook signs in. Change it only if another client of that service already uses the default.
# Default: munitas-notebook
# MUNITAS_NOTEBOOK_CLIENT_ID=munitas-notebook

# ------------------------------------------------------------------------------------------------------------------
# Containers, networks and work queues
#
# The names the worker uses for the Docker networks, the image and the work queue of the containers it starts. They
# change only if the Compose project is renamed.
# ------------------------------------------------------------------------------------------------------------------

# The Docker network that a sandboxed agent run's own container joins. It is internal, with no route out.
# Default: munitas_agentnet
# MUNITAS_AGENTNET=munitas_agentnet

# The only Docker network that a custom pipeline step's container joins when it reads files. It is internal, with no
# route to the internet. The one thing on it is a small gateway that forwards the platform's step routes and nothing
# else.
# Default: munitas_stepnet
# MUNITAS_STEPNET=munitas_stepnet

# The Docker network that the file staging container reaches storage on. Never the agent network.
# Default: munitas_data
# MUNITAS_DATA_NETWORK=munitas_data

# The work queue that the Docker dependent half of agent runs is routed to, so that a second worker inside the Linux
# distribution, next to the Docker socket, can serve just that.
# Default: munitas-sandbox-run
# MUNITAS_SANDBOX_TASK_QUEUE=munitas-sandbox-run

# The image that the three containers of a derivation (a query that makes a new dataset) run from.
# Default: munitas-derive-runner:1
# MUNITAS_DERIVE_IMAGE=munitas-derive-runner:1

# ------------------------------------------------------------------------------------------------------------------
# How long access lasts
#
# The lifetimes of the credentials and keys the platform hands out. Short lifetimes are the point: access ends by
# itself.
# ------------------------------------------------------------------------------------------------------------------

# How long a minted credential lasts. It is short, because the whole argument for leases is that access expires on
# its own and does not wait for somebody to remember.
# Unit: minutes.
# Default: 60 minutes.
# MUNITAS_CREDENTIAL_TTL_MINUTES=60

# The longest a table catalog token may live. A token carries a person's purpose and nothing else, and each table it
# opens is still decided on its own.
# Unit: hours.
# Default: 12 hours.
# MUNITAS_CATALOG_TOKEN_MAX_HOURS=12

# The longest a storage key handed out by the table catalog lasts. A key is one of a rolling series, so it lives
# between half of this and all of it. Values below 40 are raised to 40, because a key could otherwise be refused
# before the document that holds it is written.
# Unit: seconds.
# Default: 3600 seconds (1 hour)
# MUNITAS_CATALOG_KEY_SECONDS=3600

# How long a write grant keeps its key after its task last asked for it. A task asks again at every step and every
# retry, so this has to outlast the longest gap between two asks, and not the length of a whole run.
# Unit: seconds.
# Default: 86400 seconds (1 day)
# MUNITAS_WRITE_GRANT_ACTIVE_SECONDS=86400

# A request to the platform that takes this long or longer is written to the log as a warning that names the route
# and the time it took, so a slow screen can be traced to the request behind it. Use 0 to switch the warning off.
# Unit: seconds.
# Default: 2 seconds.
# MUNITAS_API_SLOW_REQUEST_SECONDS=2

# The longest a notebook stays signed in as a person, in hours, however often it renews its pass. The person can end
# it sooner. Docker Compose gives the same value to the sign-in service, so the platform and the service cannot
# disagree. A change applies to sign-ins approved after it.
# Unit: hours.
# Default: 8 hours.
# MUNITAS_NOTEBOOK_SIGN_IN_HOURS=8

# How long a notebook's pass lasts before the notebook renews it, in minutes. Short on purpose: a copied pass stops
# working soon, and the renewal is automatic. Read by Docker Compose and given to the sign-in service.
# Unit: minutes.
# Default: 15 minutes.
# MUNITAS_NOTEBOOK_ACCESS_TOKEN_MINUTES=15

# ------------------------------------------------------------------------------------------------------------------
# Closing an organisation and legal holds
#
# An organisation is closed in two waiting periods and then deleted unless a legal hold stands. Each organisation
# takes its dates from these settings when its closing starts, so changing them never moves a countdown that is
# already running.
# ------------------------------------------------------------------------------------------------------------------

# The first waiting period of closing an organisation. Its people can still read and may cancel the closing.
# Unit: days.
# Default: 15 days.
# MUNITAS_RETIRING_DAYS=15

# The second waiting period. Its people can do nothing, and a platform administrator may place a legal hold. When
# both periods end and no hold stands, everything inside the organisation is deleted.
# Unit: days.
# Default: 15 days.
# MUNITAS_CLOSING_DAYS=15

# How long a proposed legal hold waits for a second administrator before it lapses and stops standing in the way of
# the deletion.
# Unit: days.
# Default: 7 days.
# MUNITAS_HOLD_APPROVAL_DAYS=7

# How long an approved legal hold runs before somebody has to look at it again.
# Unit: days.
# Default: 90 days.
# MUNITAS_HOLD_REVIEW_DAYS=90

# How many years the audit rows of a deleted organisation (who read what) are kept, after which they are removed.
# Seven is the retention period the platform was asked to meet.
# Unit: years.
# Default: 7 years.
# MUNITAS_AUDIT_RETENTION_YEARS=7

# How often the platform looks for organisations whose time is up. 0 turns the timer off, and the sweep can still be
# run by hand. A verification run uses 0 so that a deletion only happens when it asks for one.
# Unit: seconds.
# Default: 300 seconds (5 minutes)
# MUNITAS_LIFECYCLE_SWEEP_SECONDS=300

# How often development samples that have run out are ended and what was made from them is deleted. 0 turns the
# timer off.
# Unit: seconds.
# Default: 60 seconds (1 minute)
# MUNITAS_DEVELOPMENT_SWEEP_SECONDS=60

# ------------------------------------------------------------------------------------------------------------------
# Legal export
#
# A legal export is an encrypted, signed package kept in a bucket of its own and deleted after a set number of days.
# ------------------------------------------------------------------------------------------------------------------

# The bucket that legal export packages are kept in.
# Default: munitas-legal-exports
# MUNITAS_LEGAL_EXPORT_BUCKET=munitas-legal-exports

# How long a package is kept before it is deleted.
# Unit: days.
# Default: 14 days.
# MUNITAS_LEGAL_EXPORT_KEEP_DAYS=14

# How long the download link of a package works.
# Unit: days.
# Default: 7 days.
# MUNITAS_LEGAL_EXPORT_LINK_DAYS=7

# How many times the download link of a package may be used.
# Unit: uses.
# Default: 3 uses.
# MUNITAS_LEGAL_EXPORT_LINK_USES=3

# The most a package may hold. A package is built on local disk, so this is a safety limit and not a design goal.
# Unit: bytes.
# Default: 2147483648 bytes (2 GiB)
# MUNITAS_LEGAL_EXPORT_MAX_BYTES=2147483648

# ------------------------------------------------------------------------------------------------------------------
# Writing a version's rows as a table
#
# A caller who names a records file is asking for a table. By default a version is then not sealed without one when
# the table cannot be written for a reason about the data or a fault in writing it: the seal is refused with the
# reason, and nothing is left behind. A caller that would rather keep the files without a table says so for one
# seal. A table that is not written because the platform was told not to, because the files are on R2, or because
# the file is too large never blocks a seal. The records file comes in one of three shapes, chosen by its name: a
# JSON list (.json), one JSON row per line (.ndjson or .jsonl) or a Parquet file (.parquet). A JSON list is read
# whole and takes about six times its size in memory, so its limit is small. The other two are read in batches, so
# their memory use does not depend on the file, and their limit is on time.
# ------------------------------------------------------------------------------------------------------------------

# Set it to off to skip writing tables entirely, so that a deployment that has not given the API enough memory for
# pyarrow can still seal versions as files.
# Default: on
# MUNITAS_ICEBERG_PROJECTION=on

# By default a version whose caller asked for a table is not sealed when the table cannot be written. Set it to off
# to seal the files anyway and record the reason.
# Default: on
# MUNITAS_ICEBERG_FAIL_CLOSED=on

# The largest JSON list file that is turned into a table while a request waits. Measured here, a JSON list takes
# about six times its size in memory.
# Unit: bytes.
# Default: 33554432 bytes (32 MiB)
# MUNITAS_ICEBERG_MAX_BYTES=33554432

# The largest newline delimited JSON or Parquet file that is turned into a table while a request waits. Such files
# are read in batches, so their limit is on time, at about 10 MB a second for JSON rows.
# Unit: bytes.
# Default: 2147483648 bytes (2 GiB)
# MUNITAS_ICEBERG_STREAM_MAX_BYTES=2147483648

# How many rows are read at a time from a newline delimited JSON or Parquet file.
# Unit: rows.
# Default: 20000 rows.
# MUNITAS_ICEBERG_BATCH_ROWS=20000

# The longest one line of newline delimited JSON may be, so that a file with no line breaks cannot fill memory.
# Unit: bytes.
# Default: 8388608 bytes (8 MiB)
# MUNITAS_ICEBERG_MAX_ROW_BYTES=8388608

# A Parquet file is read one row group at a time. A file whose row groups are larger than this when uncompressed, as
# its own footer states, is refused, because that is the amount that has to be held at once.
# Unit: bytes.
# Default: 268435456 bytes (256 MiB)
# MUNITAS_ICEBERG_PARQUET_MAX_ROW_GROUP_BYTES=268435456

# The longest string the Parquet footer may declare. The footer is read with limits, because a hostile footer is the
# usual way to make a reader allocate without bound.
# Unit: bytes.
# Default: 67108864 bytes (64 MiB)
# MUNITAS_ICEBERG_PARQUET_THRIFT_STRING_BYTES=67108864

# The most items one list in the Parquet footer may declare, for the same reason.
# Unit: items.
# Default: 1000000 items.
# MUNITAS_ICEBERG_PARQUET_THRIFT_CONTAINER_ITEMS=1000000

# How long writing one table may take before it is given up. Every call that leaves the process needs a deadline.
# Unit: seconds.
# Default: 300 seconds (5 minutes)
# MUNITAS_ICEBERG_TIMEOUT_SECONDS=300

# How many rows go in one Parquet row group when a table is written. 0 leaves the library's own default of about a
# million. A reader fetches one row group at a time, so a smaller group spreads a long scan over more, separate
# storage requests.
# Unit: rows.
# Default: 0, which leaves the library's own default of about a million rows.
# MUNITAS_ICEBERG_ROW_GROUP_ROWS=

# The number of bytes after which a table's rows continue in a new data file. 0 means the platform's own default of
# 64 MB. The library counts uncompressed bytes held in memory and holds that much before it writes a file, so 64 MB
# keeps a large write within a bounded share of memory, and the files come out several times smaller after
# compression. A tool that reads one file at a time opens each with the key it held when it started, so many small
# files spread a long read over many separate key checks.
# Unit: bytes.
# Default: 0, which means the platform's own default of 64 MiB.
# MUNITAS_ICEBERG_FILE_BYTES=

# ------------------------------------------------------------------------------------------------------------------
# Bringing in a table in parts
#
# A person sends a large file in parts through the platform, each of which can be sent again, and the file becomes a
# table that a worker writes. These limits keep a few people from slowing everybody else down. An organisation's own
# limits (its largest file, how many tables are written at once, how much it may keep waiting and bring in a day)
# are limits, which the organisation can lower.
# ------------------------------------------------------------------------------------------------------------------

# How long an upload that has not been finished stays open, and so how long it holds a version number. After this
# the parts already sent are thrown away.
# Unit: hours.
# Default: 24 hours.
# MUNITAS_TABLE_UPLOAD_LIFE_HOURS=24

# How many uploads one person may have open at once, meaning started and not yet finished or cancelled.
# Unit: items.
# Default: 3 items.
# MUNITAS_TABLE_UPLOAD_OPEN_PER_PERSON=3

# How many rows of a table about people a table worker sends to the platform to be locked in one call. Larger is
# faster until one call is slow enough for everybody else to notice.
# Unit: rows.
# Default: 5000 rows.
# MUNITAS_TABLE_LOCK_BATCH_ROWS=5000

# The most rows the platform accepts to lock in one call from a table worker. A call with more is refused.
# Unit: rows.
# Default: 10000 rows.
# MUNITAS_TABLE_LOCK_MAX_ROWS=10000

# How many uploads one person may start in an hour.
# Unit: items.
# Default: 20 items.
# MUNITAS_TABLE_UPLOAD_PER_HOUR=20

# How many of one person's tables may be refused or fail in an hour before they are asked to wait. A file that is
# wrong still costs a worker time to find out.
# Unit: items.
# Default: 10 items.
# MUNITAS_TABLE_UPLOAD_REFUSED_PER_HOUR=10

# How many parts of one upload may be sent at the same moment. Each part is held in memory while it is stored.
# Unit: items.
# Default: 4 items.
# MUNITAS_TABLE_UPLOAD_PARTS_IN_FLIGHT=4

# How many parts, across every organisation, the platform will take at the same moment. Past this a part is turned
# away with a time to wait, so a few large uploads cannot slow everyone else down.
# Unit: items.
# Default: 16 items.
# MUNITAS_TABLE_UPLOAD_REQUESTS_IN_FLIGHT=16

# ------------------------------------------------------------------------------------------------------------------
# Large tables (table jobs)
#
# A table that is large is written by a worker, in a job, and not while a request waits. A seal that names a records
# file bigger than the inline limit becomes a job. A job is not tied to a request's deadline, so its size limit is
# far higher than the request limit, and its time limit is the lifetime of its key. The limits a job works within
# are sent to the worker by the platform, so they are set here and nowhere else.
# ------------------------------------------------------------------------------------------------------------------

# Set it to off to switch table jobs off. Every table is then written inside the request, within the size limits
# that apply to a request, and a caller who asks for a table to be written in the background is refused.
# Default: on
# MUNITAS_TABLE_JOBS=on

# A seal that names a records file bigger than this becomes a job. A caller can also ask for a job, or refuse one.
# Unit: bytes.
# Default: 33554432 bytes (32 MiB)
# MUNITAS_TABLE_JOB_INLINE_BYTES=33554432

# The largest records file a job accepts.
# Unit: bytes.
# Default: 17179869184 bytes (16 GiB)
# MUNITAS_TABLE_JOB_MAX_BYTES=17179869184

# How long a job's storage key lives, which is the time limit of the job.
# Unit: seconds.
# Default: 14400 seconds (4 hours)
# MUNITAS_TABLE_JOB_TTL_SECONDS=14400

# A job that has waited this long for a worker is reported on the Storage housekeeping page as stalled.
# Unit: seconds.
# Default: 600 seconds (10 minutes)
# MUNITAS_TABLE_JOB_STALL_SECONDS=600

# How often the platform hands waiting jobs to workers.
# Unit: seconds.
# Default: 3 seconds.
# MUNITAS_TABLE_JOB_DISPATCH_SECONDS=3

# Set on a dedicated table worker: the one organisation it serves, on that organisation's own line of work, and it
# refuses a job of any other. Left out, the worker serves the shared pool.
# Default: Not set.
# MUNITAS_TABLE_TENANT=

# The organisation that the dedicated table worker in Docker Compose serves. It is passed to the worker as
# MUNITAS_TABLE_TENANT.
# Default: Not set.
# MUNITAS_TABLE_WORKER_TENANT=

# ------------------------------------------------------------------------------------------------------------------
# De-identification models and pipeline runs
#
# The speech and detection models the worker loads, and the organisation that pipeline runs started from this
# machine belong to.
# ------------------------------------------------------------------------------------------------------------------

# The speech to text model. Eight gigabytes of video memory is the binding constraint, so models load and unload in
# sequence and do not stay resident.
# Default: large-v3
# MUNITAS_WHISPER_MODEL=large-v3

# The numeric precision of the speech model. The default keeps the large model to roughly 3 to 4 GB of video memory.
# Default: int8_float16
# MUNITAS_WHISPER_COMPUTE=int8_float16

# The device the speech model runs on. The devices registered today are cuda and cpu.
# Default: cuda
# MUNITAS_WHISPER_DEVICE=cuda

# The GLiNER model, one of the detectors that finds identifying detail in text.
# Default: urchade/gliner_medium-v2.1
# MUNITAS_GLINER_MODEL=urchade/gliner_medium-v2.1

# The spaCy language model, one of the detectors that finds names and places in text.
# Default: en_core_web_lg
# MUNITAS_SPACY_MODEL=en_core_web_lg

# The organisation that pipeline runs started from this machine belong to. They are verification runs, so by default
# they land in a test organisation named canary and not beside an example organisation. Change it to point the
# worker at a real organisation.
# Default: canary
# MUNITAS_TENANT=canary

# ------------------------------------------------------------------------------------------------------------------
# Logging
#
# What the control plane writes to its log output. It logs identifiers and numbers, never contents.
# ------------------------------------------------------------------------------------------------------------------

# The level of the control plane's log: DEBUG, INFO, WARNING, ERROR or CRITICAL. The platform writes no debug lines,
# so DEBUG shows nothing more than INFO. That is deliberate: a debug level that can be switched on in production
# invites logging more than belongs there.
# Default: INFO
# MUNITAS_LOG_LEVEL=INFO
