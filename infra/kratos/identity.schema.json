{
  "$id": "https://munitas.example/schemas/identity.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Munitas directory identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "name": {
          "type": "string",
          "title": "Name"
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
